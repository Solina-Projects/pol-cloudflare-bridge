<?xml version="1.0" encoding="utf-8"?>
<!-- پنجرهٔ شروع برای Android 8 تا 11: گرادیان آیکن + نماد سفید وسط -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00B3A5"
                android:endColor="#0A3C70" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center"
        android:drawable="@drawable/ic_bridge_foreground" />
</layer-list>
